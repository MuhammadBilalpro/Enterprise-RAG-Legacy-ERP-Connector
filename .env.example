ADMIN_PASSWORD=replace-with-a-unique-admin-password
FINANCE_PASSWORD=replace-with-a-unique-finance-password
EMPLOYEE_PASSWORD=replace-with-a-unique-employee-password
# true only when serving behind HTTPS
COOKIE_SECURE=false
# Optional: an Ollama server you control and a model already installed there.
# Docker Desktop: http://host.docker.internal:11434
OLLAMA_URL=
OLLAMA_MODEL=
